# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# .env is gitignored — never commit real keys.

# ── Required for LLM enrichment ───────────────────────────────────────────────
# Anthropic API key.  Without this, mapping Layer C and the reporter's narrative
# sections fall back to deterministic output — everything else still runs.
# Get a key at https://console.anthropic.com
LLM_API_KEY=

# ── Optional overrides ────────────────────────────────────────────────────────
# Estimated hours before Helios power degrades after losing Aquifer coolant.
# Default: 48.0  (see candidate/design_log.md Decision 25)
# HELIOS_COOLANT_DEGRADATION_HOURS=48.0
